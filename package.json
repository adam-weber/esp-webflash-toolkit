{
  "name": "esp-webflash-toolkit",
  "version": "0.2.0",
  "type": "module",
  "description": "Headless ESP32 flashing library for the browser - framework agnostic, event-driven",
  "keywords": [
    "esp32",
    "esp8266",
    "firmware",
    "flasher",
    "web-serial",
    "nvs",
    "partition-table",
    "esptool"
  ],
  "author": "Adam Weber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-weber/esp-webflash-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/adam-weber/esp-webflash-toolkit/issues"
  },
  "homepage": "https://github.com/adam-weber/esp-webflash-toolkit#readme",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "exports": {
    ".": {
      "import": "./dist/core/index.js"
    },
    "./core": {
      "import": "./dist/core/index.js"
    },
    "./adapters/vanilla": {
      "import": "./dist/adapters/vanilla/index.js"
    },
    "./nvs-generator": {
      "import": "./dist/core/nvs-generator.js"
    },
    "./partition-table-generator": {
      "import": "./dist/core/partition-table-generator.js"
    },
    "./dist/*": "./dist/*"
  },
  "browser": {
    ".": "./dist/esp-webflash-toolkit.min.js",
    "./full": "./dist/esp-webflash-toolkit-full.min.js"
  },
  "bin": {
    "esp-webflash-toolkit": "./bin/cli.js"
  },
  "files": [
    "dist/",
    "templates/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node bin/cli.js",
    "prepublishOnly": "npm run build",
    "docs:build": "npx honkit build docs",
    "docs:serve": "npx honkit serve docs",
    "docs:pdf": "npx honkit pdf docs esp-webflash-toolkit-docs.pdf"
  },
  "dependencies": {
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  }
}
