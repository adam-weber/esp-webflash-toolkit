{
  "name": "esp-webflash-toolkit",
  "version": "0.2.0",
  "type": "module",
  "description": "Headless ESP32 flashing library for the browser - framework agnostic, event-driven",
  "keywords": [
    "esp32",
    "esp8266",
    "firmware",
    "flasher",
    "web-serial",
    "nvs",
    "partition-table",
    "esptool"
  ],
  "author": "Adam Weber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-weber/esp-webflash-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/adam-weber/esp-webflash-toolkit/issues"
  },
  "homepage": "https://github.com/adam-weber/esp-webflash-toolkit#readme",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "exports": {
    ".": {
      "import": "./dist/core/index.js"
    },
    "./core": {
      "import": "./dist/core/index.js"
    },
    "./adapters/vanilla": {
      "import": "./dist/adapters/vanilla/index.js"
    },
    "./nvs-generator": {
      "import": "./dist/core/nvs-generator.js"
    },
    "./component": {
      "import": "./dist/components/esp-flasher.js"
    },
    "./dist/*": "./dist/*"
  },
  "browser": {
    ".": "./dist/esp-webflash-toolkit.min.js",
    "./full": "./dist/esp-webflash-toolkit-full.min.js",
    "./component": "./dist/esp-flasher-component.min.js"
  },
  "bin": {
    "esp-webflash-toolkit": "./bin/cli.js"
  },
  "files": [
    "dist/",
    "templates/",
    "bin/",
    "scripts/generate-page.js",
    "src/core/config-schema.js",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node tests/nvs-generator.test.js && node tests/config-schema.test.js && node tests/flash-states.test.js && node tests/error-catalog.test.js",
    "dev": "node bin/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  }
}
